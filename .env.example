# DynamoDB
# ローカル開発用のダミー値です。AWS CLI / Terraform の認証には使わず、
# シェルで `.env` を丸ごと source しないでください。
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_REGION=ap-northeast-1
DYNAMODB_ENDPOINT=http://localhost:8000

# AI APIs
SECRETS_MANAGER_ENABLED=false
GEMINI_SECRET_ARN=
CEREBRAS_SECRET_ARN=
GROQ_SECRET_ARN=
GEMINI_API_KEY=your_gemini_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Judging
# ローカルDBを使う開発環境では、ローカルワーカーで審査する
LOCAL_JUDGE_WORKER=true
# リクエスト内で即時採点したい場合のみ true にする
SYNCHRONOUS_JUDGE=false
# SQS を使う構成に戻す場合のみ設定する
SQS_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/<account-id>/judgment-queue
DYNAMODB_TABLE_POSTS=aruaruarena_development

# Rails
RAILS_ENV=development
SECRET_KEY_BASE=your_secret_key_base_here
