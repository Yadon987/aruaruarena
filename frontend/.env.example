# API Base URL
# 開発環境: Viteプロキシ経由（推奨）
VITE_API_BASE_URL=/api

# 開発環境でMSWを使う場合: true / 本番APIと同条件で検証する場合: false
VITE_USE_MOCK_API=false

# MSWを使う場合、Viteプロキシはこの先の開発APIへ転送される
VITE_API_PROXY_TARGET=http://localhost:3000

# 本番環境: API Gatewayのカスタムドメイン（例）
# VITE_API_BASE_URL=https://api.aruaru-arena.example.com/api

# Frontend Base URL（シェア用URL生成に使用）
# 開発環境: localhost
VITE_FRONTEND_BASE_URL=http://localhost:5173

# 本番環境: 実際のドメイン
# VITE_FRONTEND_BASE_URL=https://aruaruarena.com

# Google Analytics 4 Measurement ID（任意）
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
